pipeline {
  agent any

  options {
    skipDefaultCheckout()
    disableConcurrentBuilds()
  }

  parameters {
    string(name: 'RELEASE_TAG', defaultValue: '', description: 'Existing release tag, e.g. v0.1.2')
  }

  stages {
    stage('Checkout release') {
      steps {
        script {
          if (!(params.RELEASE_TAG ==~ /v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)/)) {
            error('RELEASE_TAG must be a stable version tag such as v0.1.2')
          }
          deleteDir()
          checkout scmGit(
            branches: [[name: "refs/tags/${params.RELEASE_TAG}"]],
            userRemoteConfigs: scm.userRemoteConfigs
          )
        }
        sh 'sh scripts/check-release.sh "$RELEASE_TAG"'
      }
    }

    stage('Verify and build') {
      steps {
        sh 'python3 -B -m unittest discover -s scripts -p "test_*.py"'
        sh './gradlew --no-daemon clean test build'
      }
    }

    stage('Publish API') {
      environment {
        UPLOAD_USERNAME = credentials('UPLOAD_USERNAME')
        UPLOAD_PASSWORD = credentials('UPLOAD_PASSWORD')
        SIGNING_KEY = credentials('SIGNING_KEY')
        SIGNING_PASSPHRASE = credentials('SIGNING_PASSPHRASE')
      }
      steps {
        sh './gradlew --no-daemon :api:deployCentralPortal'
      }
    }

  }

  post {
    always {
      cleanWs()
    }
  }
}
